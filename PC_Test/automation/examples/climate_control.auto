# 示例：温控自动化 —— 演示 条件/分支/计时/状态变量

规则 "温度控制" {
    # 温度过高 -> 开风扇，否则关风扇
    如果 data.temperature > 30 {
        执行 开风扇
    } 否则 {
        执行 关风扇
    }

    # 湿度低且土壤干燥 -> 蜂鸣提示（演示逻辑与）
    当 data.humidity < 40 && data.soil_dry == true {
        执行 蜂鸣器.beep(count=3, on_ms=200, off_ms=200)
    }
}

规则 "离家灯光" {
    # 演示设置状态变量 + 循环 + 等待
    设置 提示次数 = 2
    循环 3 {
        如果 data.motion == true {
            执行 开灯
        } 否则 {
            执行 关灯
        }
        等待 1 秒
    }
}
