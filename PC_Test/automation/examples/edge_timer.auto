# 示例：边沿去重 + 定时器事件

规则 "烟雾边沿报警" {
    # 边沿触发：只在烟雾从 无->有 时报警一次，之后即使数据持续为 true 也不重复报警
    边沿 data.smoke {
        执行 蜂鸣器.开
        执行 红灯
    }

    # 下降沿：烟雾解除时关蜂鸣、关灯
    边沿 下降 data.smoke {
        执行 蜂鸣器.关
        执行 关灯
    }
}

规则 "定时上报" {
    # 周期定时器：每 3 秒把温度推送到 OLED
    每 3 秒 {
        执行 oled.text(line=0, text="tick")
    }

    # 一次性定时器：启动 5 秒后关灯（防止忘关）
    定时 5 秒 {
        执行 关灯
    }
}
