# 示例：烟雾报警自动化
# 正确写法：用「边沿」触发，开关分离，避免重复触发/时序错乱。
# 语法说明见 README，用 python run_automation.py examples/smoke_alarm.auto 运行

规则 "烟雾报警联动" {
    # 上升沿：烟雾从 无->有 时才报警一次（不会因数据持续为 true 反复触发）
    边沿 data.smoke {
        执行 蜂鸣器.开
        执行 红灯
        执行 开窗
    }

    # 下降沿：烟雾解除时关闭报警
    边沿 下降 data.smoke {
        执行 蜂鸣器.关
        执行 关灯
        执行 关窗
    }
}
