# docker compose 环境变量示例 —— 复制为 PC_Test/.env 后按本机实际修改
#   cp docker/.env.example .env
# 查设备： ls -l /dev/ttyUSB* /dev/ttyACM* /dev/video*

TZ=Asia/Shanghai

# Arduino A/B 板串口（CH340 克隆板多为 ttyUSB，正版 Uno 多为 ttyACM）
SERIAL_PORT_A=/dev/ttyUSB0
SERIAL_PORT_B=/dev/ttyUSB1

# USB 摄像头
CAMERA_DEVICE=/dev/video0

# 麦克风索引（多声卡时先执行
#   docker compose run --rm voice python voice_assistant.py --list-mic
# 再填数字；默认留空=系统默认设备）
MIC_INDEX=
# 纯硬件网关（无麦克风、只做人脸开门联动）时，在 docker-compose.override.yml
# 给 voice 设 SMART_HOME_DISABLE_MIC=1

# 对外端口（一般不用改）
QWEN_PORT=8000
VOICE_PORT=8101
WEB_PORT=5000
CAMERA_PORT=8080

# 仅 docker-compose.dashscope.yml 使用
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
