# docker compose 环境变量示例 —— 复制为 PC_Test/.env 后按本机实际修改
#   cp docker/.env.example .env
# 查设备： ls -l /dev/ttyUSB* /dev/ttyACM* /dev/video*

TZ=Asia/Shanghai

# Arduino A/B 板串口（CH340 克隆板多为 ttyUSB，正版 Uno 多为 ttyACM）
SERIAL_PORT_A=/dev/ttyUSB0
SERIAL_PORT_B=/dev/ttyUSB1

# USB 摄像头
CAMERA_DEVICE=/dev/video0

# 麦克风索引（多声卡时先执行
#   docker compose run --rm voice python voice_assistant.py --list-mic
# 再填数字；默认留空=系统默认设备）
MIC_INDEX=
# 纯硬件网关（无麦克风、只做人脸开门联动）时，在 docker-compose.override.yml
# 给 voice 设 SMART_HOME_DISABLE_MIC=1

# 对外端口（一般不用改）
QWEN_PORT=8000
VOICE_PORT=8101
WEB_PORT=5000
CAMERA_PORT=8080

# 云端 LLM（默认引擎：硅基流动 SiliconFlow，OpenAI 兼容端点）
# Key 申请：https://cloud.siliconflow.cn/account/ak   （容器里只认这里的 Key，
# PC_Test/llm_key.txt 已被 .dockerignore 排除，不会进镜像）
# 改服务商示例：LLM_MODE=dashscope
#               LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#               LLM_MODEL=qwen-plus
# 走本地 llama.cpp：docker compose -f docker-compose.yml -f docker-compose.local-llm.yml up -d
LLM_MODE=siliconflow
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=Qwen/Qwen3.5-4B
