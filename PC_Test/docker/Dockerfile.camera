# camera_stream.py —— USB 摄像头 MJPEG 视频流（轻量镜像，无 X11 依赖）
# 摄像头设备由 compose 透传（默认 /dev/video0）。
FROM python:3.12-slim

# headless 版 OpenCV 只需要 libglib2.0-0（无需 libGL/X11）
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        libgomp1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker/requirements-camera.txt /tmp/requirements-camera.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/requirements-camera.txt

COPY . /app

EXPOSE 8080
# 探 /health 而不是 /：/ 只要 Flask 起着就永远 200，摄像头一根帧都没有也判不出问题。
# /health 由采集线程存活决定（200=正常，503=采集线程已死）；没插摄像头仍是 200，
# 因为热插拔下「等待设备」是可用状态，不该让容器被判死。
HEALTHCHECK --interval=20s --timeout=8s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/health',timeout=5).status==200 else 1)"

ENTRYPOINT ["tini", "--"]
# 不写死 --cam：由 camera_stream.py 枚举 /dev/video*（CAMERA_DEVICE 只作优先候选），
# 拔插换序号后下一轮重开就能找到
CMD ["python", "-u", "camera_stream.py", "--mode", "web", "--host", "0.0.0.0", "--port", "8080"]
