# run_web.py —— Web 仪表盘 + YOLOv8-face/ArcFace 人脸识别 + 唯一硬件网关
# 本容器独占 Arduino 串口：run_web.py 拉起 mcp_home_server.py（MCP stdio 子进程）。
# 语音助手不再碰串口，改经本容器的 /api/hardware/tools|/api/hardware/tool 调用硬件。
# 无串口的桌面体验可用 --no-serial 覆盖 CMD（见 docker-compose.desktop.yml）。
FROM python:3.12-slim

# libgl1/libglib2.0-0：ultralytics 自带 opencv-python（非 headless）的运行库
# libgomp1：onnxruntime / numpy OpenMP
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker/requirements-web.txt /tmp/requirements-web.txt

# 先走 PyTorch CPU 专用 index 装 torch/torchvision（否则默认轮子带 CUDA，镜像大 2GB+）。
# x86_64 与 aarch64 的 CPU 轮子均由该 index 提供。
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install torch torchvision \
        --index-url https://download.pytorch.org/whl/cpu \
    && pip install -r /tmp/requirements-web.txt

# ultralytics 默认要写 /root/.config（容器内只读根时告警），固定到可写的 /tmp
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    YOLO_CONFIG_DIR=/tmp/Ultralytics

COPY . /app

EXPOSE 5000
HEALTHCHECK --interval=20s --timeout=8s --start-period=90s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:5000/api/health',timeout=5).status==200 else 1)"

ENTRYPOINT ["tini", "--"]
# 默认连串口（compose 已透传 A/B 板 + /dev）；无硬件桌面用 override 换 --no-serial
CMD ["python", "-u", "run_web.py", "--host", "0.0.0.0", "--port", "5000"]
