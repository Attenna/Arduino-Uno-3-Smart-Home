# voice_assistant.py —— 语音助手（Sherpa-ONNX KWS/ASR/TTS）+ 内置 MCP 串口客户端
# 本容器独占 Arduino 串口（compose 里以 devices 透传 /dev/ttyUSB* 或 /dev/ttyACM*）。
FROM python:3.12-slim

# libportaudio2 = sounddevice 麦克风采集；libsndfile1 = 音频文件读写
RUN apt-get update && apt-get install -y --no-install-recommends \
        libportaudio2 \
        libsndfile1 \
        libgomp1 \
        alsa-utils \
        tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker/requirements-voice.txt /tmp/requirements-voice.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r /tmp/requirements-voice.txt

COPY . /app

EXPOSE 8101
HEALTHCHECK --interval=20s --timeout=8s --start-period=90s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8101/state',timeout=5).status==200 else 1)"

ENTRYPOINT ["tini", "--"]
# LLM 地址/串口/麦克风由 compose 环境变量注入（SMART_HOME_LLM_BASE_URL 等）
CMD ["python", "-u", "voice_assistant.py", "--llm-mode", "local"]
